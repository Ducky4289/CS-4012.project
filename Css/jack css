@charset "UTF-8";

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: #f3f6f8;
    color: #263746;
    font-family: Arial, sans-serif;
    line-height: 1.6;
}

.banner {
    padding: 2.5rem 1rem;
    background: #244767;
    color: white;
    text-align: center;
}

.banner h1 {
    margin: 0;
}

.banner p {
    margin-bottom: 0;
}


.navbar {
    background: #183b5b;
}

.navbar ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0.85rem 1rem;
    list-style: none;
}

.navbar a {
    color: white;
    font-weight: bold;
    text-decoration: none;
}

.navbar a:hover,
.navbar a:focus {
    color: #f6d58b;
    text-decoration: underline;
}

.content {
    width: min(100% - 2rem, 960px);
    margin: 0 auto;
    padding: 1.5rem 0 3rem;
}

.content > h2 {
    color: #183b5b;
    text-align: center;
}


.place-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.75rem;
    margin: 1rem 0 2rem;
    padding: 0;
    list-style: none;
}

.place-options a {
    display: block;
    padding: 0.75rem 1rem;
    border: 1px solid #c8d4df;
    border-radius: 8px;
    background: white;
    color: #245b8f;
    font-weight: bold;
    text-align: center;
    text-decoration: none;
}

.place-options a:hover,
.place-options a:focus {
    background: #e5f0f8;
}

/* Destination sections */
.content > section {
    margin: 1.25rem 0;
    padding: 1.5rem;
    border: 1px solid #e0e7ed;
    border-radius: 12px;
    background: white;
    box-shadow: 0 4px 14px #183b5b14;
    scroll-margin-top: 1rem;
}

.content > section h2 {
    margin-top: 0;
    color: #245b8f;
}

.content > section h3 {
    margin: 1.5rem 0 0.5rem;
    color: #386b5a;
}


.content details {
    margin: 0.55rem 0;
    border: 1px solid #d8e1e8;
    border-radius: 8px;
    background: #f9fbfc;
}

.content summary {
    padding: 0.7rem 0.9rem;
    color: #245b8f;
    cursor: pointer;
    font-weight: bold;
}

.content details[open] summary {
    border-bottom: 1px solid #d8e1e8;
    background: #eef5fa;
}

.content details p {
    margin: 0;
    padding: 0.75rem 0.9rem;
}


.media-area {
    display: grid;
    min-height: 160px;
    margin-top: 1.5rem;
    padding: 1rem;
    place-items: center;
    border: 2px dashed #9aabb9;
    border-radius: 10px;
    background: #f8fafc;
    color: #5d6f7d;
    text-align: center;
}

.media-area img,
.media-area video {
    display: block;
    width: 100%;
    max-width: 720px;
    height: auto;
    border-radius: 8px;
}

@media (max-width: 600px) {
    .content {
        width: min(100% - 1rem, 960px);
    }

    .content > section {
        padding: 1rem;
    }

    .navbar ul {
        gap: 0.5rem 1rem;
    }
}
